<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- 제목 및 위치 이동 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="운동 타이머"
            android:textColor="#171717"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMoveUp"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="↑"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnMoveDown"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="↓"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- 운동 시간 -->
    <TextView
        android:id="@+id/tvWorkoutElapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:text="00:00:00"
        android:textColor="#171717"
        android:textSize="38sp"
        android:textStyle="bold" />

    <!-- 타이머 조작 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTimerStart"
            android:layout_width="130dp"
            android:layout_height="46dp"
            android:backgroundTint="#5B6BD5"
            android:text="시작"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnTimerPause"
            android:layout_width="130dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="#5B6BD5"
            android:text="일시정지"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnTimerReset"
            android:layout_width="110dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="#F3F4F6"
            android:text="초기화"
            android:textColor="#666666"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
