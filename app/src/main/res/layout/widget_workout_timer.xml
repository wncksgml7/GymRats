<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="20dp" android:background="@drawable/bg_widget_card"
    android:gravity="center" android:orientation="vertical" android:padding="22dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="운동 타이머" android:textColor="#171717" android:textSize="19sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/tvWorkoutElapsed" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:fontFamily="sans-serif" android:text="00:00:00" android:textColor="#171717"
        android:textSize="38sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/btnTimerStart" android:layout_width="130dp"
            android:layout_height="46dp" android:backgroundTint="#5B6BD5"
            android:text="시작" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnTimerPause" android:layout_width="130dp"
            android:layout_height="46dp" android:layout_marginStart="10dp"
            android:backgroundTint="#5B6BD5" android:text="일시정지"
            android:textColor="#FFFFFF" android:visibility="gone" />
        <Button android:id="@+id/btnTimerReset" android:layout_width="110dp"
            android:layout_height="46dp" android:layout_marginStart="10dp"
            android:backgroundTint="#F3F4F6" android:text="초기화"
            android:textColor="#666666" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>