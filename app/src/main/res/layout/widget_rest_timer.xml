<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_widget_card" android:orientation="vertical" android:padding="18dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="세트 사이 휴식 타이머" android:textColor="#171717" android:textSize="19sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="휴식 시간을 설정하세요." android:textColor="#999999" android:textSize="13sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
        <Button android:id="@+id/btnRest30" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="30초" android:textSize="12sp" android:textAllCaps="false"/>
        <Button android:id="@+id/btnRest60" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="60초" android:textSize="12sp" android:textAllCaps="false"/>
        <Button android:id="@+id/btnRest90" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="90초" android:textSize="12sp" android:textAllCaps="false"/>
        <Button android:id="@+id/btnRest120" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="120초" android:textSize="12sp" android:textAllCaps="false"/>
    </LinearLayout>
    <TextView android:id="@+id/tvRestTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="01:30" android:textColor="#171717" android:textSize="38sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/btnRestStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="#5B6BD5" android:text="시작" android:textColor="#FFFFFF" android:textAllCaps="false"/>
        <Button android:id="@+id/btnRestPause" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="#5B6BD5" android:text="일시정지" android:textColor="#FFFFFF" android:textAllCaps="false" android:visibility="gone"/>
        <Button android:id="@+id/btnRestReset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:backgroundTint="#F3F4F6" android:text="초기화" android:textColor="#777777" android:textAllCaps="false" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>