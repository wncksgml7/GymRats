<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F6FA">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="뒤로가기" android:src="@drawable/ic_arrow_back" />
        <ImageView android:id="@+id/imageAuthorProfile" android:layout_width="80dp" android:layout_height="80dp"
            android:layout_marginTop="12dp" android:contentDescription="프로필 사진" android:src="@android:drawable/ic_menu_myplaces" />
        <TextView android:id="@+id/textAuthorNickname" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="프로필 불러오는 중" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/textAuthorFollowCounts" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="16sp" />
        <Button android:id="@+id/btnFollowAuthor" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="12dp" android:text="팔로우" android:enabled="false" />
        <TextView android:id="@+id/textFollowMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#B3261E" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/textAuthorProfileMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/btnRetryAuthorProfile" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="다시 불러오기" android:visibility="gone" />
        <!-- 내 페이지와 같은 카드 레이아웃을 사용합니다. -->
        <include layout="@layout/include_profile_modules" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
