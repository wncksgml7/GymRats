<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 뒤로가기와 화면 제목 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="운동법 상세"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 게시글 내용 -->
        <ScrollView
            android:id="@+id/scrollPostDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 세로 영상도 잘리지 않도록 원본 비율에 맞춰 재생합니다. -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/postVideoPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginBottom="12dp"
                    android:background="#17151D"
                    android:contentDescription="@string/post_video_description"
                    android:visibility="gone"
                    app:resize_mode="fit"
                    app:surface_type="texture_view"
                    app:show_buffering="always"
                    app:use_controller="true" />

                <TextView
                    android:id="@+id/textVideoPlaybackStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/post_video_loading"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnRetryVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/post_video_retry"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <!-- 작성자를 누르면 공개 프로필로 이동 -->
                <Button
                    android:id="@+id/btnPostAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="작성자 정보 불러오는 중" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textDetailLikes"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_post_heart"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textDetailComments"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:drawableStart="@drawable/ic_post_comment"
                        android:drawableTint="#77717F"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textDetailRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:drawableStart="@drawable/ic_post_star"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 운동 분류와 기구 -->
                <Button
                    android:id="@+id/btnBookmark"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:enabled="false"
                    android:text="북마크 담기" />
                <TextView
                    android:id="@+id/textDetailPrimaryBodyPart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textDetailSecondaryBodyParts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textDetailEquipment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="16sp" />

                <!-- 운동 방법 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="운동 설명"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textIsSelectable="true"
                    android:textSize="16sp" />

                <!-- 주의사항 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="주의사항"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetailPrecaution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textIsSelectable="true"
                    android:textSize="16sp" />

                <!-- 후기와 자유 댓글은 각각 독립된 목록입니다. -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="28dp">
                    <Button android:id="@+id/btnReviewsTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="운동 후기" />
                    <Button android:id="@+id/btnCommentsTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="질문·댓글" />
                </LinearLayout>
                <TextView android:id="@+id/textDiscussionError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3261E" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/btnDiscussionRetry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="다시 불러오기" android:visibility="gone" />
                <Button android:id="@+id/btnWriteReview" android:layout_width="match_parent" android:layout_height="56dp" android:text="후기 작성하기" />
                <LinearLayout android:id="@+id/commentComposer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
                <LinearLayout android:id="@+id/discussionList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" />

            </LinearLayout>

        </ScrollView>

        <!-- 로딩과 조회 실패 안내 -->
        <ProgressBar
            android:id="@+id/progressPostDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/textDetailMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textSize="16sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
