<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.gymrats.ui.home.HomeFragment"
        android:label="Home" />

    <navigation
        android:id="@+id/communityGraph"
        app:startDestination="@id/communityFragment">

        <!-- 다른 회원의 공개 프로필 -->
        <fragment
            android:id="@+id/authorProfileFragment"
            android:name="com.gymrats.ui.community.AuthorProfileFragment"
            android:label="작성자 프로필">

            <argument
                android:name="userId"
                app:argType="string" />

        </fragment>

        <!-- 선택한 게시글의 ID를 받아 상세 화면 표시 -->
        <fragment
            android:id="@+id/postDetailFragment"
            android:name="com.gymrats.ui.community.PostDetailFragment"
            android:label="운동법 상세">

            <argument
                android:name="postId"
                app:argType="string" />

        </fragment>

        <fragment
            android:id="@+id/communityFragment"
            android:name="com.gymrats.ui.community.CommunityFragment"
            android:label="Community" />

        <fragment
            android:id="@+id/worldCupFragment"
            android:name="com.gymrats.ui.worldcup.WorldCupFragment"
            android:label="World Cup" />

        <fragment
            android:id="@+id/postCreateFragment"
            android:name="com.gymrats.ui.community.PostCreateFragment"
            android:label="운동법 등록" />

    </navigation>

    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.gymrats.ui.profile.MyPageFragment"
        android:label="My Page" />

</navigation>