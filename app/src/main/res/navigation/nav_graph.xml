<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.gymrats.ui.home.HomeFragment"
        android:label="Home" />

    <navigation
        android:id="@+id/communityGraph"
        app:startDestination="@id/communityFragment">

        <!-- 다른 회원의 공개 프로필 -->
        <fragment
            android:id="@+id/authorProfileFragment"
            android:name="com.gymrats.ui.community.AuthorProfileFragment"
            android:label="작성자 프로필">

            <argument
                android:name="userId"
                app:argType="string" />
        </fragment>

        <!-- 게시글 상세 -->
        <fragment
            android:id="@+id/postDetailFragment"
            android:name="com.gymrats.ui.community.PostDetailFragment"
            android:label="운동법 상세">

            <argument
                android:name="postId"
                app:argType="string"/>

            <!-- 커뮤니티 그룹 밖(내 정보 화면)에서도 열 수 있게 하는 주소 -->
            <deepLink app:uri="gymrats://post/{postId}" />
        </fragment>

        <!-- 운동 후기 작성 -->
        <fragment
            android:id="@+id/reviewCreateFragment"
            android:name="com.gymrats.ui.community.ReviewCreateFragment"
            android:label="운동 후기 작성">

            <argument
                android:name="postId"
                app:argType="string" />

            <argument
                android:name="postTitle"
                app:argType="string"
                android:defaultValue="운동법" />
        </fragment>

        <fragment
            android:id="@+id/communityFragment"
            android:name="com.gymrats.ui.community.CommunityFragment"
            android:label="Community" />

        <fragment
            android:id="@+id/worldCupFragment"
            android:name="com.gymrats.ui.worldcup.WorldCupFragment"
            android:label="World Cup" />

        <fragment
            android:id="@+id/postCreateFragment"
            android:name="com.gymrats.ui.community.PostCreateFragment"
            android:label="운동법 등록" />

    </navigation>

    <!-- 마이페이지 -->
    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.gymrats.ui.profile.MyPageFragment"
        android:label="My Page" />

    <!-- 알림 화면 -->
    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.gymrats.ui.notification.NotificationFragment"
        android:label="알림" />

    <!-- 내가 만든 운동법 전체 목록 -->
    <fragment
        android:id="@+id/myPostsFragment"
        android:name="com.gymrats.ui.profile.MyPostsFragment"
        android:label="내가 만든 운동법" />

    <!-- 내가 쓴 후기·댓글 목록 -->
    <fragment
        android:id="@+id/myCommentsFragment"
        android:name="com.gymrats.ui.profile.MyCommentsFragment"
        android:label="내가 쓴 후기·댓글" />

</navigation>
